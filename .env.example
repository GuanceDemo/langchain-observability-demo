# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://llm-openway.guance.com
LANGFUSE_OTLP_COMPRESSION=none
LANGFUSE_DEBUG_HTTP=0
# 如需覆盖默认 OTLP 路径，可显式指定
# LANGFUSE_OTEL_TRACES_EXPORT_PATH=api/public/otel/v1/traces

# OTEL LangChain instrumentation
OTEL_SERVICE_NAME=langchain-observability-demo
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://llm-openway.guance.com/v1/write/otel-llm
OTEL_EXPORTER_OTLP_HEADERS=To-Headless=true,X-Token=<agent_token>
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# 全局筛选类字段建议放到 resource.attributes
# 标准 OTEL 环境变量格式：key=value,key=value
OTEL_RESOURCE_ATTRIBUTES=agent_id=<agent_id>,agent_name=langchain-otel,agent_runtime=langchain

# 模型提供方
# 可选：auto / compatible / ollama
MODEL_PROVIDER=compatible

# 方式 A：OpenAI-compatible 网关
OPENAI_BASE_URL=http://43.98.191.89:8317/v1
OPENAI_API_KEY=
OPENAI_MODEL=claude-sonnet-4.5

# 方式 B：本地 Ollama
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b

# Demo 元数据
DEMO_TOPIC=OpenTelemetry
DEMO_STYLE=回答简洁，优先给可执行建议
DEMO_SESSION_ID=langchain-demo-session
DEMO_USER_ID=demo-user
DEPLOYMENT_ENV=demo
APP_VERSION=0.1.0
